# Copy this file to .env and adjust values for local development.
# Never commit the real .env file.

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=missing_persons
POSTGRES_USER=missing_persons
POSTGRES_PASSWORD=change-me

# NCMEC Missing Child Poster Distribution API credentials (see docs/ for access notes).
# Leave blank locally unless you have been issued credentials.
NCMEC_CLIENT_ID=
NCMEC_CLIENT_SECRET=
